# Helpdesk Agent Studio — Environment Variables
# Copy to .env and fill in values. NEVER commit .env itself.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://studio:studio_dev@localhost:7702/helpdesk_studio

# --- Approval Token Signing ---
# Must be at least 32 bytes. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_TOKEN_KEY=

# --- Slack OAuth (Read-Only Agent Client) ---
SLACK_AGENT_CLIENT_ID=
SLACK_AGENT_CLIENT_SECRET=
SLACK_AGENT_REDIRECT_URI=http://localhost:7701/api/oauth/slack/callback
SLACK_SIGNING_SECRET=

# --- Slack OAuth (Write Executor Client) ---
SLACK_EXECUTOR_CLIENT_ID=
SLACK_EXECUTOR_CLIENT_SECRET=
SLACK_EXECUTOR_REDIRECT_URI=http://localhost:7701/api/oauth/slack/callback

# --- Jira OAuth (Read-Only Agent Client) ---
JIRA_AGENT_CLIENT_ID=
JIRA_AGENT_CLIENT_SECRET=
JIRA_AGENT_REDIRECT_URI=http://localhost:7701/api/oauth/jira/callback

# --- Jira OAuth (Write Executor Client) ---
JIRA_EXECUTOR_CLIENT_ID=
JIRA_EXECUTOR_CLIENT_SECRET=
JIRA_EXECUTOR_REDIRECT_URI=http://localhost:7701/api/oauth/jira/callback

# --- Jira Webhook ---
JIRA_WEBHOOK_SECRET=

# --- KMS ---
# For dev: use LocalStack endpoint
AWS_KMS_ENDPOINT=http://localhost:7708
AWS_KMS_KEY_ID=alias/helpdesk-studio
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCAL_KMS_KEY=

# --- Keycloak (IdP) ---
KEYCLOAK_URL=http://localhost:7705
KEYCLOAK_REALM=helpdesk-studio
KEYCLOAK_CLIENT_ID=helpdesk-dashboard
KEYCLOAK_CLIENT_SECRET=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:7710
OTEL_SERVICE_NAME=helpdesk-agent-studio

# --- Fake Providers ---
FAKE_PROVIDER_URL=http://localhost:7704
